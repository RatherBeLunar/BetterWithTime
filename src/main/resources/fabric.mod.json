{
	"schemaVersion": 1,
	"id": "bwt",
	"version": "${version}",
	"name": "Better With Time",
	"description": "A modern adaptation of Better Than Wolves' tech features",
	"authors": [
      "RatherBeLunar"
	],
    "contributors": [
      "FlowerChild",
      "stohun",
      "primetoxinz",
      "ivangeevo",
      "zero318",
      "ikabod",
      "Tetro48"
    ],
	"contact": {
      "homepage": "https://modrinth.com/mod/better-with-time",
      "sources": "https://github.com/RatherBeLunar/BetterWithTime",
      "issues": "https://github.com/RatherBeLunar/BetterWithTime/issues"
	},
    "custom": {
      "modmenu": {
        "links": {
          "modmenu.discord": "https://discord.gg/WUtwPTws2f"
        }
      }
