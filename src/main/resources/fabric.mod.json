			"config": "betterwithtime.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "1.21.5",
		"java": ">=21",
		"fabric-api": ">=0.128.2+1.21.5"
	},
	"suggests": {
		"emi": ">=1.1.24+1.21.1+fabric"
	}
}